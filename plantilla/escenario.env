# Escenario <NOMBRE>: <algoritmo> para <problema>.
# Rutas relativas a esta carpeta. Cualquier variable se puede sobreescribir
# desde el entorno, ej:  K=8 python3 scripts/Ejecutor.py <NOMBRE> irace
# Las variables de este archivo tambien llegan al target-runner (por ejemplo
# TIME_LIMIT): agrega aqui las que necesite tu algoritmo.

# --- Instancias ---
# Una instancia por linea, ruta relativa a esta carpeta (ej: instancias/x/a1.txt).
# TRAIN_SUBSETS (solo h-irace): las MISMAS lineas que TRAIN, en el MISMO orden,
# con :<subset> al final (ej: instancias/x/a1.txt:1). h-irace asocia cada linea
# con la instancia de entrenamiento de la misma posicion.
TRAIN=instancias/listas/TRAIN.txt
TRAIN_SUBSETS=instancias/listas/TRAIN_SUBSETS.txt
TEST=instancias/listas/TEST.txt

# --- Tuning ---
MAX_EXPERIMENTS=1000      # presupuesto de cada corrida de irace / h-irace
SEMILLAS_TUNING=20        # corridas independientes: semillas 1..20
IRACE_PARALLEL=1          # evaluaciones simultaneas DENTRO de cada corrida

# --- Testing ---
SEMILLAS_TEST=20          # ejecuciones por (configuracion, instancia): semillas 1..20

# --- Paralelismo ---
K=20                      # corridas (o ejecuciones de test) a la vez

# --- Algoritmo ---
TIME_LIMIT=10             # ejemplo: lo lee el target-runner
