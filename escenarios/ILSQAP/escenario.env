# Escenario ILS-QAP (Stutzle) para QAP, instancias de 60 facilidades.
# Rutas relativas a esta carpeta. Cualquier variable se puede sobreescribir
# desde el entorno, ej:  TIME_LIMIT=2 python3 scripts/Ejecutor.py ILSQAP irace

# --- Instancias ---
# Subsets: :1 Euclidean Structured (60-0.90/ES), :2 tai-like random (60rr/tailike)
TRAIN=instancias/listas/trainQAP.txt
TRAIN_SUBSETS=instancias/listas/trainQAP_SUBSETS.txt
TEST=instancias/listas/testQAP.txt
# Test por subset: instancias/listas/testQAP_S1.txt, instancias/listas/testQAP_S2.txt

# --- Tuning ---
# Presupuesto de cada corrida de irace / h-irace. Los experimentos usaron 1000
# ("1M"/"1K") y 5000 ("5M"/"5K"): para 5000 usar  --budget 5000 --nombre <tuner>_5K
MAX_EXPERIMENTS=1000
SEMILLAS_TUNING=20        # corridas independientes: semillas 1..20
IRACE_PARALLEL=1          # evaluaciones simultaneas DENTRO de cada corrida

# --- Testing ---
SEMILLAS_TEST=20          # ejecuciones por (configuracion, instancia): semillas 1..20

# --- Paralelismo ---
K=20

# --- Algoritmo ---
TIME_LIMIT=10             # segundos por ejecucion de ilsqap (--time)
