# Escenario HGS (pyVRP 0.5.0) para VRPTW, instancias Solomon y Homberger.
# Rutas relativas a esta carpeta. Cualquier variable se puede sobreescribir
# desde el entorno, ej:  TIME_LIMIT=2 python3 scripts/Ejecutor.py HGS irace

# --- Instancias ---
# irace usa TRAIN; h-irace usa TRAIN + TRAIN_SUBSETS (mismas lineas, mismo orden,
# con :<subset> al final). Otras opciones en instancias/listas/README.md
TRAIN=instancias/listas/both_TRAIN.txt
TRAIN_SUBSETS=instancias/listas/both_TRAIN_SUBSETS.txt
TEST=instancias/listas/both_TEST.txt

# --- Tuning ---
MAX_EXPERIMENTS=5000      # presupuesto de cada corrida de irace / h-irace
SEMILLAS_TUNING=20        # corridas independientes: semillas 1..20
IRACE_PARALLEL=1          # evaluaciones simultaneas DENTRO de cada corrida

# --- Testing ---
SEMILLAS_TEST=20          # ejecuciones por (configuracion, instancia): semillas 1..20

# --- Paralelismo ---
# K corridas (o ejecuciones de test) a la vez. Procesos totales = K * IRACE_PARALLEL
K=20

# --- Algoritmo ---
TIME_LIMIT=10             # segundos que se le dan a pyVRP en cada ejecucion
INFEASIBLE_COST=1000000   # costo que se devuelve si la mejor solucion es infactible
# Interprete con pyVRP 0.5.0 (por defecto el .venv que crea setup.sh)
#PYTHON_BIN=/ruta/a/tu/venv/bin/python
